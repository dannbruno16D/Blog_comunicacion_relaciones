---
const { items = [] } = Astro.props;
---

<div class="accordion">
  {items.map((item, index) => (
    <div class="accordion-item">
      <button class="accordion-btn" data-index={index}>
        {item.question}
      </button>
      <div class="accordion-content">
        <p>{item.answer}</p>
      </div>
    </div>
  ))}
</div>

<script>
  document.querySelectorAll('.accordion-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const content = btn.nextElementSibling;
      content.classList.toggle('open');
    });
  });
</script>

<style>
  .accordion {
    margin: 2rem 0;
  }

  .accordion-item {
    margin-bottom: 1rem;
    border: 1px solid #ccc;
    border-radius: 10px;
    overflow: hidden;
  }

  .accordion-btn {
    width: 100%;
    text-align: left;
    padding: 1rem;
    border: none;
    background: #f5f5f5;
    font-size: 1rem;
    cursor: pointer;
  }

  .accordion-btn:hover {
    background: #e9e9e9;
  }

  .accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
    padding: 0 1rem;
    background: white;
  }

  .accordion-content.open {
    max-height: 200px;
    padding: 1rem;
  }
</style>