<section class="ruta-laboral">

	<div class="intro-ruta">
		<span class="mini">Ruta profesional</span>

		<h2>
			Del conocimiento de una organización
			a la entrevista de trabajo
		</h2>

		<p>
			Explora las tres etapas seleccionando cada sección.
			Encontrarás información, actividades y ejemplos para
			comprender mejor cada tema.
		</p>
	</div>


	<!-- =====================================================
	     NAVEGACIÓN ENTRE LOS 3 TEMAS
	===================================================== -->

	<div class="pasos">

		<button type="button" class="paso activo" data-panel="empresas">
			<span class="numero">1</span>
			<span>Empresas e instituciones</span>
		</button>

		<div class="linea"></div>

		<button type="button" class="paso" data-panel="curriculum">
			<span class="numero">2</span>
			<span>Currículum vitae</span>
		</button>

		<div class="linea"></div>

		<button type="button" class="paso" data-panel="entrevista">
			<span class="numero">3</span>
			<span>Entrevista de trabajo</span>
		</button>

	</div>


	<!-- =====================================================
	     1. EMPRESAS E INSTITUCIONES
	===================================================== -->

	<div class="panel activo" id="empresas">

		<div class="cabecera-panel">

			<div class="texto">

				<span class="etiqueta">Etapa 1</span>

				<h2>Empresas e instituciones</h2>

				<p>
					Las empresas e instituciones son organizaciones
					formadas por personas que trabajan de manera coordinada
					para alcanzar determinados objetivos.
				</p>

				<p>
					Para funcionar utilizan diferentes recursos, como
					recursos humanos, materiales, tecnológicos y financieros.
				</p>

			</div>


			<img
				src="/images/mundo-laboral/empresa-institucion.jpg"
				alt="Personas trabajando dentro de una organización"
			/>

		</div>


		<h3 class="subtitulo">¿Empresa o institución?</h3>


		<div class="comparacion">

			<article class="comparacion-card empresa">

				<div class="icono">🏢</div>

				<h3>Empresa</h3>

				<p>
					Es una organización que produce bienes o presta
					servicios para satisfacer determinadas necesidades.
				</p>

				<ul>
					<li>Puede tener fines económicos.</li>
					<li>Produce bienes o presta servicios.</li>
					<li>Cuenta con trabajadores y recursos.</li>
					<li>Busca alcanzar objetivos establecidos.</li>
				</ul>

				<div class="ejemplo">
					<strong>Ejemplos:</strong>
					una tienda, un banco, una fábrica o una empresa
					de tecnología.
				</div>

			</article>


			<article class="comparacion-card institucion">

				<div class="icono">🏛️</div>

				<h3>Institución</h3>

				<p>
					Es una organización creada para cumplir una función
					determinada dentro de la sociedad.
				</p>

				<ul>
					<li>Puede ser pública o privada.</li>
					<li>Tiene normas y objetivos establecidos.</li>
					<li>Atiende diferentes necesidades sociales.</li>
					<li>Organiza actividades y responsabilidades.</li>
				</ul>

				<div class="ejemplo">
					<strong>Ejemplos:</strong>
					una universidad, un hospital o una dependencia
					gubernamental.
				</div>

			</article>

		</div>


		<div class="dato">

			<span>💡</span>

			<div>
				<strong>Algo importante</strong>

				<p>
					Tanto las empresas como las instituciones necesitan
					una buena comunicación para coordinar a sus integrantes,
					resolver problemas y trabajar en equipo.
				</p>
			</div>

		</div>

	</div>



	<!-- =====================================================
	     2. CURRÍCULUM VITAE
	===================================================== -->

	<div class="panel" id="curriculum">

		<div class="cabecera-panel invertida">

			<div class="texto">

				<span class="etiqueta">Etapa 2</span>

				<h2>Currículum vitae</h2>

				<p>
					El currículum vitae, también conocido como CV,
					es un documento que resume la formación académica,
					experiencia, habilidades y otros aspectos relevantes
					de una persona.
				</p>

				<p>
					Su objetivo es presentar nuestro perfil de una manera
					clara y ordenada cuando buscamos una oportunidad
					académica o laboral.
				</p>

			</div>


			<img
				src="/images/mundo-laboral/curriculum-vitae.jpg"
				alt="Currículum vitae sobre un escritorio"
			/>

		</div>


		<!-- RETO INTERACTIVO -->

		<div class="reto-cv">

			<div class="reto-cabecera">

				<div>
					<span class="mini">Actividad interactiva</span>

					<h3>¿Qué debe incluir un currículum?</h3>

					<p>
						Selecciona los elementos que consideres adecuados
						para un CV. Algunas opciones son incorrectas.
					</p>
				</div>


				<div class="marcador-cv">
					<strong id="aciertosCV">0</strong>
					<span>/ 5 correctos</span>
				</div>

			</div>


			<div class="opciones-cv">


				<!-- CORRECTA -->

				<button
					type="button"
					class="opcion-cv"
					data-correcta="true"
					data-explicacion="Los medios de contacto permiten que la empresa pueda comunicarse contigo."
				>

					<span class="opcion-icono">📞</span>

					<span class="opcion-texto">
						<strong>Datos de contacto</strong>
						<small>Correo electrónico y teléfono.</small>
					</span>

					<span class="resultado-icono"></span>

				</button>



				<!-- INCORRECTA -->

				<button
					type="button"
					class="opcion-cv"
					data-correcta="false"
					data-explicacion="Nunca debes incluir contraseñas en un currículum ni compartirlas con una empresa."
				>

					<span class="opcion-icono">🔐</span>

					<span class="opcion-texto">
						<strong>Contraseña del correo</strong>
						<small>
							Para que la empresa pueda verificar tu cuenta.
						</small>
					</span>

					<span class="resultado-icono"></span>

				</button>



				<!-- CORRECTA -->

				<button
					type="button"
					class="opcion-cv"
					data-correcta="true"
					data-explicacion="La formación académica permite conocer tus estudios y preparación."
				>

					<span class="opcion-icono">🎓</span>

					<span class="opcion-texto">
						<strong>Formación académica</strong>
						<small>Estudios, institución y periodo.</small>
					</span>

					<span class="resultado-icono"></span>

				</button>



				<!-- INCORRECTA -->

				<button
					type="button"
					class="opcion-cv"
					data-correcta="false"
					data-explicacion="Los datos bancarios son información privada y no forman parte de un currículum."
				>

					<span class="opcion-icono">💳</span>

					<span class="opcion-texto">
						<strong>Datos de tarjeta bancaria</strong>
						<small>Número de tarjeta y cuenta.</small>
					</span>

					<span class="resultado-icono"></span>

				</button>



				<!-- CORRECTA -->

				<button
					type="button"
					class="opcion-cv"
					data-correcta="true"
					data-explicacion="La experiencia permite mostrar las actividades y responsabilidades que has realizado."
				>

					<span class="opcion-icono">💼</span>

					<span class="opcion-texto">
						<strong>Experiencia y proyectos</strong>
						<small>
							Empleos, prácticas o proyectos relevantes.
						</small>
					</span>

					<span class="resultado-icono"></span>

				</button>



				<!-- INCORRECTA -->

				<button
					type="button"
					class="opcion-cv"
					data-correcta="false"
					data-explicacion="Agregar información falsa puede afectar tu credibilidad durante un proceso de selección."
				>

					<span class="opcion-icono">🤥</span>

					<span class="opcion-texto">
						<strong>Experiencia inventada</strong>
						<small>
							Agregar empleos para que el CV se vea mejor.
						</small>
					</span>

					<span class="resultado-icono"></span>

				</button>



				<!-- CORRECTA -->

				<button
					type="button"
					class="opcion-cv"
					data-correcta="true"
					data-explicacion="Las habilidades muestran qué conocimientos y capacidades puedes aportar."
				>

					<span class="opcion-icono">🧠</span>

					<span class="opcion-texto">
						<strong>Habilidades</strong>
						<small>
							Conocimientos técnicos y habilidades personales.
						</small>
					</span>

					<span class="resultado-icono"></span>

				</button>



				<!-- CORRECTA -->

				<button
					type="button"
					class="opcion-cv"
					data-correcta="true"
					data-explicacion="Los idiomas, cursos y certificaciones pueden complementar tu formación."
				>

					<span class="opcion-icono">🌎</span>

					<span class="opcion-texto">
						<strong>Idiomas y certificaciones</strong>
						<small>Formación complementaria relevante.</small>
					</span>

					<span class="resultado-icono"></span>

				</button>


			</div>


			<div class="respuesta-cv" id="respuestaCV">
				Selecciona una opción para comenzar.
			</div>


			<div class="completado-cv" id="completadoCV">

				<span>🎉</span>

				<div>
					<strong>¡Completaste el reto!</strong>

					<p>
						Identificaste los cinco elementos adecuados
						para incluir en un currículum.
					</p>
				</div>

			</div>


			<button
				type="button"
				class="reiniciar-cv"
				id="reiniciarCV"
			>
				↻ Reiniciar actividad
			</button>

		</div>



		<!-- CONSEJOS -->

		<div class="consejos-cv">

			<h3>Consejos para elaborar un buen CV</h3>

			<div class="consejos-grid">

				<div>
					<span>01</span>
					<p>
						Mantén una estructura clara y fácil de leer.
					</p>
				</div>

				<div>
					<span>02</span>
					<p>
						Evita información innecesaria o demasiado extensa.
					</p>
				</div>

				<div>
					<span>03</span>
					<p>
						Adapta el contenido al puesto que estás buscando.
					</p>
				</div>

				<div>
					<span>04</span>
					<p>
						Revisa cuidadosamente la ortografía antes de enviarlo.
					</p>
				</div>

			</div>

		</div>

	</div>



	<!-- =====================================================
	     3. ENTREVISTA DE TRABAJO
	===================================================== -->

	<div class="panel" id="entrevista">

		<div class="cabecera-panel">

			<div class="texto">

				<span class="etiqueta">Etapa 3</span>

				<h2>La entrevista de trabajo</h2>

				<p>
					La entrevista de trabajo es una conversación entre
					una persona que busca empleo y un representante
					de una organización.
				</p>

				<p>
					Permite conocer mejor al candidato, sus habilidades,
					experiencia, intereses y forma de comunicarse.
				</p>

			</div>


			<img
				src="/images/mundo-laboral/entrevista-trabajo.jpg"
				alt="Entrevista de trabajo entre dos personas"
			/>

		</div>


		<h3 class="subtitulo">
			Antes, durante y después
		</h3>


		<div class="momentos">

			<article>

				<span class="momento-numero">
					Antes
				</span>

				<div class="momento-icono">
					🔎
				</div>

				<h3>Prepárate</h3>

				<p>
					Investiga la organización, revisa tu CV y piensa
					cómo explicar tus conocimientos y experiencias.
				</p>

			</article>


			<article>

				<span class="momento-numero">
					Durante
				</span>

				<div class="momento-icono">
					🗣️
				</div>

				<h3>Comunícate</h3>

				<p>
					Escucha las preguntas, responde con claridad
					y demuestra respeto, seguridad e interés.
				</p>

			</article>


			<article>

				<span class="momento-numero">
					Después
				</span>

				<div class="momento-icono">
					✅
				</div>

				<h3>Reflexiona</h3>

				<p>
					Analiza tu desempeño e identifica aspectos
					que puedes mejorar para futuras entrevistas.
				</p>

			</article>

		</div>



		<!-- SIMULADOR DE ENTREVISTA -->

		<div class="simulador">

			<div class="simulador-cabecera">

				<div>

					<span class="mini">
						Actividad interactiva
					</span>

					<h3>
						Simulador de entrevista
					</h3>

				</div>


				<span class="microfono">
					🎙️
				</span>

			</div>


			<p class="instruccion">
				Presiona el botón para practicar una pregunta típica
				de una entrevista de trabajo.
			</p>


			<div class="pregunta-box">

				<span>Pregunta</span>

				<h3 id="preguntaEntrevista">
					¿Por qué te interesa trabajar en esta organización?
				</h3>

			</div>


			<div class="acciones">

				<button
					type="button"
					id="otraPregunta"
				>
					🎲 Otra pregunta
				</button>


				<button
					type="button"
					id="mostrarConsejo"
				>
					💡 Ver consejo
				</button>

			</div>


			<div
				class="consejo"
				id="consejoEntrevista"
			>

				<strong>Consejo:</strong>

				<p id="textoConsejo">
					Relaciona tus intereses con las actividades,
					valores u objetivos de la organización.
				</p>

			</div>

		</div>



		<!-- CIERRE -->

		<div class="cierre">

			<div class="cierre-icono">
				🚀
			</div>

			<div>

				<h3>
					Prepararse también es comunicarse
				</h3>

				<p>
					Conocer una organización, elaborar correctamente
					un currículum y prepararse para una entrevista
					son pasos relacionados entre sí.

					En todos ellos, la comunicación, la confianza
					y la presentación de nuestras capacidades tienen
					un papel fundamental.
				</p>

			</div>

		</div>

	</div>

</section>



<script>

	const root = document.querySelector('.ruta-laboral');

	if (root) {


		/* ==================================================
		   CAMBIAR ENTRE LOS 3 TEMAS
		================================================== */

		const botones = root.querySelectorAll('.paso');
		const paneles = root.querySelectorAll('.panel');


		botones.forEach((boton) => {

			boton.addEventListener('click', () => {

				const id =
					boton.getAttribute('data-panel');


				botones.forEach((b) =>
					b.classList.remove('activo')
				);


				paneles.forEach((p) =>
					p.classList.remove('activo')
				);


				boton.classList.add('activo');


				if (id) {

					const panel =
						root.querySelector(`#${id}`);

					panel?.classList.add('activo');

				}

			});

		});



		/* ==================================================
		   RETO DEL CURRÍCULUM
		================================================== */

		const opcionesCV =
			root.querySelectorAll('.opcion-cv');

		const respuestaCV =
			root.querySelector('#respuestaCV');

		const aciertosCV =
			root.querySelector('#aciertosCV');

		const completadoCV =
			root.querySelector('#completadoCV');

		const reiniciarCV =
			root.querySelector('#reiniciarCV');


		let aciertos = 0;


		opcionesCV.forEach((opcion) => {

			opcion.addEventListener('click', () => {


				/* Evita seleccionar la misma dos veces */

				if (
					opcion.classList.contains('respondida')
				) {
					return;
				}


				opcion.classList.add('respondida');


				const correcta =
					opcion.getAttribute('data-correcta')
					=== 'true';


				const explicacion =
					opcion.getAttribute('data-explicacion')
					?? '';


				const iconoResultado =
					opcion.querySelector('.resultado-icono');



				/* RESPUESTA CORRECTA */

				if (correcta) {

					opcion.classList.add('correcta');


					if (iconoResultado) {
						iconoResultado.textContent = '✓';
					}


					aciertos++;


					if (respuestaCV) {

						respuestaCV.innerHTML =
							`<strong>✅ Correcto.</strong> ${explicacion}`;

					}

				}


				/* RESPUESTA INCORRECTA */

				else {

					opcion.classList.add('incorrecta');


					if (iconoResultado) {
						iconoResultado.textContent = '✕';
					}


					if (respuestaCV) {

						respuestaCV.innerHTML =
							`<strong>❌ No debería incluirse.</strong> ${explicacion}`;

					}

				}



				/* ACTUALIZA CONTADOR */

				if (aciertosCV) {

					aciertosCV.textContent =
						String(aciertos);

				}



				/* COMPLETÓ LAS 5 */

				if (aciertos === 5) {

					completadoCV?.classList.add(
						'visible'
					);

				}

			});

		});



		/* REINICIAR ACTIVIDAD */

		reiniciarCV?.addEventListener(
			'click',
			() => {

				aciertos = 0;


				if (aciertosCV) {
					aciertosCV.textContent = '0';
				}


				opcionesCV.forEach((opcion) => {

					opcion.classList.remove(
						'respondida',
						'correcta',
						'incorrecta'
					);


					const icono =
						opcion.querySelector(
							'.resultado-icono'
						);


					if (icono) {
						icono.textContent = '';
					}

				});


				if (respuestaCV) {

					respuestaCV.textContent =
						'Selecciona una opción para comenzar.';

				}


				completadoCV?.classList.remove(
					'visible'
				);

			}
		);



		/* ==================================================
		   SIMULADOR DE ENTREVISTA
		================================================== */

		const preguntas = [

			{
				pregunta:
					'¿Por qué te interesa trabajar en esta organización?',

				consejo:
					'Relaciona tus intereses con las actividades, valores u objetivos de la organización.'
			},

			{
				pregunta:
					'Háblame un poco sobre ti.',

				consejo:
					'Presenta brevemente tu formación, habilidades e intereses relacionados con el puesto.'
			},

			{
				pregunta:
					'¿Cuáles consideras que son tus principales fortalezas?',

				consejo:
					'Menciona fortalezas reales y acompáñalas con algún ejemplo concreto.'
			},

			{
				pregunta:
					'¿Qué aspecto te gustaría mejorar de ti mismo?',

				consejo:
					'Elige un aspecto real y explica qué estás haciendo para mejorarlo.'
			},

			{
				pregunta:
					'¿Cómo actuarías ante un conflicto con un compañero?',

				consejo:
					'Destaca la comunicación, el respeto, la escucha y la búsqueda de soluciones.'
			},

			{
				pregunta:
					'¿Cómo trabajas cuando tienes varias tareas al mismo tiempo?',

				consejo:
					'Explica cómo organizas tus prioridades, tiempos y responsabilidades.'
			}

		];


		let indice = 0;


		const pregunta =
			root.querySelector(
				'#preguntaEntrevista'
			);

		const consejo =
			root.querySelector(
				'#consejoEntrevista'
			);

		const textoConsejo =
			root.querySelector(
				'#textoConsejo'
			);

		const otraPregunta =
			root.querySelector(
				'#otraPregunta'
			);

		const mostrarConsejo =
			root.querySelector(
				'#mostrarConsejo'
			);



		/* SIGUIENTE PREGUNTA */

		otraPregunta?.addEventListener(
			'click',
			() => {

				indice =
					(indice + 1)
					% preguntas.length;


				if (pregunta) {

					pregunta.textContent =
						preguntas[indice].pregunta;

				}


				if (textoConsejo) {

					textoConsejo.textContent =
						preguntas[indice].consejo;

				}


				consejo?.classList.remove(
					'visible'
				);

			}
		);



		/* MOSTRAR CONSEJO */

		mostrarConsejo?.addEventListener(
			'click',
			() => {

				consejo?.classList.toggle(
					'visible'
				);

			}
		);

	}

</script>



<style>

	/* ======================================================
	   GENERAL
	====================================================== */

	.ruta-laboral {
		margin: 2rem 0 4rem;
	}

	.intro-ruta {
		max-width: 760px;
		margin: 0 auto 3rem;
		text-align: center;
	}

	.mini,
	.etiqueta {
		color: #6366f1;
		font-weight: 800;
		font-size: 0.78rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.intro-ruta h2 {
		font-size: clamp(2rem, 5vw, 3.3rem);
		line-height: 1.15;
		margin: .7rem 0 1rem;
	}

	.intro-ruta p {
		color: #667085;
		line-height: 1.8;
	}



	/* ======================================================
	   NAVEGACIÓN
	====================================================== */

	.pasos {
		display: flex;
		align-items: center;
		justify-content: center;
		margin: 2.5rem 0 3rem;
	}

	.paso {
		border: 0;
		background: transparent;
		cursor: pointer;

		display: flex;
		flex-direction: column;
		align-items: center;

		gap: .6rem;

		font-weight: 700;
		color: #7a8190;

		max-width: 170px;

		text-align: center;

		transition: .3s ease;
	}

	.numero {
		width: 48px;
		height: 48px;

