<html lang="es">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />

		<main>
			<!-- =========================
			     PORTADA
			========================= -->
			<section class="hero">
				<div class="hero-contenido">
					<span class="etiqueta">Comunicación y Relaciones Humanas</span>

					<h1>
						Conectar, comprender
