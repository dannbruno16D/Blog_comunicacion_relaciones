---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`Acerca del proyecto | ${SITE_TITLE}`}
			description={SITE_DESCRIPTION}
		/>
	</head>

	<body>
		<Header />

		<main>

			<!-- ==========================================
			     PORTADA
			========================================== -->

			<section class="hero-about">

				<div class="formas">
					<div class="forma forma-1"></div>
					<div class="forma forma-2"></div>
				</div>

				<div class="logos">

					<div class="logo-card">
						<img
							src="/images/about/logo-uaemex.png"
							alt="Logo de la Universidad Autónoma del Estado de México"
						/>
					</div>

					<div class="separador-logo"></div>

					<div class="logo-card">
						<img
							src="/images/about/logo-cu-atlacomulco.png"
							alt="Logo del Centro Universitario UAEM Atlacomulco"
						/>
					</div>

				</div>


				<div class="hero-contenido">

					<span class="etiqueta">
						Proyecto académico
					</span>

					<h1>
						Comunicación y
						<span>Relaciones Humanas</span>
					</h1>

					<p>
						Espacio académico desarrollado para presentar
						los principales temas estudiados durante la materia,
						así como reflexiones, conceptos y actividades relacionadas
						con la comunicación y las relaciones humanas.
					</p>

				</div>

			</section>



			<!-- ==========================================
			     INFORMACIÓN DEL PROYECTO
			========================================== -->

			<section class="informacion seccion-aparecer">

				<div class="titulo-seccion">

					<span>Información académica</span>

					<h2>Acerca del proyecto</h2>

					<p>
						Este sitio web fue desarrollado como parte de las
						actividades de la asignatura Comunicación y Relaciones
						Humanas.
					</p>

				</div>


				<div class="datos-grid">

					<article class="dato-card">

						<div class="dato-icono">
							🎓
						</div>

						<div>
							<span>Institución</span>

							<h3>
								Universidad Autónoma del Estado de México
							</h3>
						</div>

					</article>


					<article class="dato-card">

						<div class="dato-icono">
							🏫
						</div>

						<div>
							<span>Plantel</span>

							<h3>
								Centro Universitario UAEM Atlacomulco
							</h3>
						</div>

					</article>


					<article class="dato-card">

						<div class="dato-icono">
							📚
						</div>

						<div>
							<span>Asignatura</span>

							<h3>
								Comunicación y Relaciones Humanas
							</h3>
						</div>

					</article>


					<article class="dato-card">

						<div class="dato-icono">
							👥
						</div>

						<div>
							<span>Grupo</span>

							<h3>
								ICO 30
							</h3>
						</div>

					</article>

				</div>

			</section>



			<!-- ==========================================
			     INTEGRANTES
			========================================== -->

			<section class="equipo seccion-aparecer">

				<div class="titulo-seccion">

					<span>Nuestro equipo</span>

					<h2>Integrantes</h2>

					<p>
						El proyecto fue realizado mediante la colaboración
						de los siguientes integrantes del grupo ICO 30.
					</p>

				</div>


				<div class="equipo-grid">


					<article class="integrante">

						<div class="avatar">
							DM
						</div>

						<div class="numero">
							01
						</div>

						<h3>
							Danna Paola Martínez Bruno
						</h3>

						<p>
							Integrante del equipo
						</p>

					</article>



					<article class="integrante">

						<div class="avatar">
							DN
						</div>

						<div class="numero">
							02
						</div>

						<h3>
							Daniela Nieves Nieves
						</h3>

						<p>
							Integrante del equipo
						</p>

					</article>



					<article class="integrante">

						<div class="avatar">
							DL
						</div>

						<div class="numero">
							03
						</div>

						<h3>
							Diego López Durán
						</h3>

						<p>
							Integrante del equipo
						</p>

					</article>



					<article class="integrante">

						<div class="avatar">
							JP
						</div>

						<div class="numero">
							04
						</div>

						<h3>
							Jollette Plata Secundino
						</h3>

						<p>
							Integrante del equipo
						</p>

					</article>



					<article class="integrante">

						<div class="avatar">
							SG
						</div>

						<div class="numero">
							05
						</div>

						<h3>
							Sergio Garduño Arriaga
						</h3>

						<p>
							Integrante del equipo
						</p>

					</article>


				</div>

			</section>



			<!-- ==========================================
			     OBJETIVO
			========================================== -->

			<section class="objetivo seccion-aparecer">

				<div class="objetivo-icono">
					💬
				</div>

				<div class="objetivo-contenido">

					<span>Propósito del sitio</span>

					<h2>
						Aprender sobre comunicación también implica comunicar
					lo aprendido
					</h2>

					<p>
						El propósito de esta página es reunir de una forma
						visual e interactiva algunos de los conocimientos
						adquiridos durante el curso.
					</p>

					<p>
						Los diferentes contenidos permiten abordar aspectos
						como la comunicación humana, la escucha activa,
						las relaciones interpersonales, el liderazgo,
						el comportamiento organizacional y el entorno laboral.
					</p>

				</div>

			</section>



			<!-- ==========================================
			     REFERENCIAS
			========================================== -->

			<section class="referencias seccion-aparecer">

				<div class="titulo-seccion">

					<span>Fuentes consultadas</span>

					<h2>Referencias bibliográficas</h2>

					<p>
						Las siguientes obras fueron utilizadas como fuentes
						de consulta para el desarrollo de los contenidos
						del proyecto.
					</p>

				</div>


				<div class="referencias-lista">


					<article class="referencia">

						<div class="ref-numero">
							01
						</div>

						<p>
							<strong>Chiavenato, I.</strong> (2019).
							<em>
								Comportamiento organizacional: La dinámica
								del éxito en las organizaciones.
							</em>
							McGraw-Hill Education.
						</p>

					</article>



					<article class="referencia">

						<div class="ref-numero">
							02
						</div>

						<p>
							<strong>
								Watzlawick, P., Beavin Bavelas, J.,
								& Jackson, D. D.
							</strong>
							(2018).
							<em>
								Teoría de la comunicación humana:
								Interacciones, patologías y paradojas.
							</em>
							Herder Editorial.
						</p>

					</article>



					<article class="referencia">

						<div class="ref-numero">
							03
						</div>

						<p>
							<strong>
								Robbins, S. P., & Judge, T. A.
							</strong>
							(2017).
							<em>
								Comportamiento organizacional.
							</em>
							Pearson Educación.
						</p>

					</article>



					<article class="referencia">

						<div class="ref-numero">
							04
						</div>

						<p>
							<strong>Goleman, D.</strong> (2018).
							<em>
								El líder resonante crea más:
								El poder de la inteligencia emocional.
							</em>
							Ediciones B.
						</p>

					</article>



					<article class="referencia">

						<div class="ref-numero">
							05
						</div>

						<p>
							<strong>
								Davis, K., & Newstrom, J. W.
							</strong>
							(2003).
							<em>
								Comportamiento humano en el trabajo.
							</em>
							McGraw-Hill.
						</p>

					</article>



					<article class="referencia">

						<div class="ref-numero">
							06
						</div>

						<p>
							<strong>
								Fernández Collado, C.
							</strong>
							(2001).
							<em>
								La comunicación humana en el mundo contemporáneo.
							</em>
							McGraw-Hill.
						</p>

					</article>



					<article class="referencia">

						<div class="ref-numero">
							07
						</div>

						<p>
							<strong>Heller, R.</strong> (2018).
							<em>Cómo liderar.</em>
							DK Publishing.
						</p>

					</article>



					<article class="referencia">

						<div class="ref-numero">
							08
						</div>

						<p>
							<strong>Schvarstein, L.</strong> (2017).
							<em>
								Diseño de organizaciones:
								Tensiones y paradojas.
							</em>
							Ediciones Paidós.
						</p>

					</article>


				</div>

			</section>



			<!-- ==========================================
			     FINAL
			========================================== -->

			<section class="final seccion-aparecer">

				<div>
					<span>ICO 30</span>

					<h2>
						Comunicación y Relaciones Humanas
					</h2>

					<p>
						Centro Universitario UAEM Atlacomulco
					</p>
				</div>

			</section>

		</main>

		<Footer />



		<script>

			const elementos =
				document.querySelectorAll(
					'.seccion-aparecer'
				);


			const observer =
				new IntersectionObserver(

					(entradas) => {

						entradas.forEach(
							(entrada) => {

								if (
									entrada.isIntersecting
								) {

									entrada.target
										.classList
										.add(
											'visible'
										);

								}

							}
						);

					},

					{
						threshold: 0.12
					}

				);


			elementos.forEach(
				(elemento) =>
					observer.observe(
						elemento
					)
			);

		</script>

	</body>
</html>



<style>

	:global(html) {
		scroll-behavior: smooth;
	}


	main {
		width: 100%;
		max-width: none;
		padding: 0;
		overflow: hidden;
	}



	/* ==========================================
	   PORTADA
	========================================== */

	.hero-about {
		position: relative;

		padding:
			70px max(7vw, 30px)
			90px;

		text-align: center;

		background:
			linear-gradient(
				135deg,
				#f8fafc,
				#eef2ff
			);

		overflow: hidden;
	}


	.logos {
		position: relative;
		z-index: 2;

		display: flex;
		align-items: center;
		justify-content: center;

		gap: 30px;

		margin-bottom: 45px;
	}


	.logo-card {
		width: 170px;
		height: 110px;

		display: flex;
		align-items: center;
		justify-content: center;

		padding: 15px;

		background:
			rgba(
				255,
				255,
				255,
				.92
			);

		border:
			1px solid #e4e7ec;

		border-radius: 18px;

		box-shadow:
			0 12px 30px
			rgba(
				40,
				50,
				80,
				.10
			);

		animation:
			flotar 5s
			ease-in-out
			infinite;
	}


	.logo-card:nth-child(3) {
		animation-delay: -.8s;
	}


	.logo-card img {
		width: 100%;
		height: 100%;

		object-fit: contain;
	}


	.separador-logo {
		width: 1px;
		height: 65px;

		background: #cfd4df;
	}


	.hero-contenido {
		position: relative;
		z-index: 2;

		max-width: 850px;

		margin: auto;

		animation:
			entrada .8s ease;
	}


	.etiqueta {
		display: inline-block;

		padding:
			7px 14px;

		border-radius: 999px;

		background: #e0e7ff;

		color: #4338ca;

		font-size: .78rem;

		font-weight: 800;

		letter-spacing: .1em;

		text-transform:
			uppercase;
	}


	.hero-about h1 {
		font-size:
			clamp(
				2.7rem,
				6vw,
				5rem
			);

		line-height: 1.05;

		margin:
			20px 0 25px;

		color: #192132;
	}


	.hero-about h1 span {
		display: block;

		background:
			linear-gradient(
				90deg,
				#2563eb,
				#7c3aed
			);

		background-clip:
			text;

		-webkit-background-clip:
			text;

		color: transparent;
	}


	.hero-about p {
		max-width: 730px;

		margin: auto;

		color: #646d7e;

		font-size: 1.08rem;

		line-height: 1.8;
	}


	.forma {
		position: absolute;

		border-radius: 50%;

		filter: blur(1px);

		opacity: .55;
	}


	.forma-1 {
		width: 260px;
		height: 260px;

		background: #bfdbfe;

		left: -90px;
		top: 40px;
	}


	.forma-2 {
		width: 220px;
		height: 220px;

		background: #ddd6fe;

		right: -70px;
		bottom: 20px;
	}



	/* ==========================================
	   GENERAL
	========================================== */

	.informacion,
	.equipo,
	.referencias {
		padding:
			90px max(7vw, 30px);
	}


	.titulo-seccion {
		max-width: 760px;

		margin:
			0 auto 50px;

		text-align: center;
	}


	.titulo-seccion > span,
	.objetivo-contenido > span {
		color: #6366f1;

		font-weight: 800;

		font-size: .78rem;

		letter-spacing: .1em;

		text-transform:
			uppercase;
	}


	.titulo-seccion h2 {
		font-size:
			clamp(
				2rem,
				4vw,
				3.1rem
			);

		margin:
			10px 0 15px;

		color: #202939;
	}


	.titulo-seccion p {
		color: #697386;

		font-size: 1.05rem;

		line-height: 1.8;
	}



	/* ==========================================
	   DATOS ACADÉMICOS
	========================================== */

	.datos-grid {
		max-width: 1100px;

		margin: auto;

		display: grid;

		grid-template-columns:
			repeat(2, 1fr);

		gap: 18px;
	}


	.dato-card {
		display: flex;

		align-items: center;

		gap: 18px;

		padding: 24px;

		border:
			1px solid #e9ebf1;

		border-radius: 18px;

		background: white;

		transition:
			transform .3s ease,
			box-shadow .3s ease;
	}


	.dato-card:hover {
		transform:
			translateY(-5px);

		box-shadow:
			0 15px 35px
			rgba(
				40,
				50,
				80,
				.10
			);
	}


	.dato-icono {
		width: 55px;
		height: 55px;

		flex-shrink: 0;

		display: grid;
		place-items: center;

		border-radius: 15px;

		background: #eef2ff;

		font-size: 1.8rem;
	}


	.dato-card span {
		display: block;

		margin-bottom: 5px;

		font-size: .75rem;

		font-weight: 800;

		text-transform:
			uppercase;

		color: #818898;
	}


	.dato-card h3 {
		margin: 0;

		font-size: 1.05rem;

		color: #30394a;
	}



	/* ==========================================
	   EQUIPO
	========================================== */

	.equipo {
		background: #f8fafc;
	}


	.equipo-grid {
		max-width: 1150px;

		margin: auto;

		display: grid;

		grid-template-columns:
			repeat(5, 1fr);

		gap: 16px;
	}


	.integrante {
		position: relative;

		min-height: 240px;

		padding: 25px 20px;

		background: white;

		border:
			1px solid #e9ebf0;

		border-radius: 20px;

		text-align: center;

		overflow: hidden;

		transition:
			transform .3s ease,
			box-shadow .3s ease;
	}


	.integrante:hover {
		transform:
			translateY(-8px);

		box-shadow:
			0 18px 38px
			rgba(
				41,
				51,
				80,
				.12
			);
	}


	.avatar {
		width: 75px;
		height: 75px;

		margin:
			15px auto 20px;

		display: grid;
		place-items: center;

		border-radius: 50%;

		background:
			linear-gradient(
				135deg,
				#4f46e5,
				#8b5cf6
			);

		color: white;

		font-size: 1.25rem;

		font-weight: 800;

		box-shadow:
			0 10px 25px
			rgba(
				79,
				70,
				229,
				.23
			);
	}


	.numero {
		position: absolute;

		right: 15px;
		top: 12px;

		font-size: 2.2rem;

		font-weight: 900;

		color: #eef0f5;
	}


	.integrante h3 {
		position: relative;

		font-size: 1rem;

		line-height: 1.45;

		color: #293244;

		margin-bottom: 10px;
	}


	.integrante p {
		font-size: .85rem;

		color: #818898;
	}



	/* ==========================================
	   OBJETIVO
	========================================== */

	.objetivo {
		max-width: 1100px;

		margin:
			100px auto;

		padding:
			45px;

		display: grid;

		grid-template-columns:
			auto 1fr;

		gap: 30px;

		align-items:
			flex-start;

		border-radius: 25px;

		background:
			linear-gradient(
				135deg,
				#111827,
				#242c3d
			);

		color: white;
	}


	.objetivo-icono {
		width: 80px;
		height: 80px;

		display: grid;
		place-items: center;

		border-radius: 20px;

		background:
			rgba(
				255,
				255,
				255,
				.1
			);

		font-size: 2.6rem;
	}


	.objetivo h2 {
		max-width: 750px;

		color: white;

		font-size:
			clamp(
				1.8rem,
				3vw,
				2.7rem
			);

		line-height: 1.25;

		margin:
			8px 0 20px;
	}


	.objetivo p {
		max-width: 820px;

		color: #d1d5db;

		line-height: 1.8;
	}



	/* ==========================================
	   REFERENCIAS
	========================================== */

	.referencias {
		background:
			linear-gradient(
				180deg,
				#ffffff,
				#f8fafc
			);
	}


	.referencias-lista {
		max-width: 1000px;

		margin: auto;

		display: grid;

		gap: 12px;
	}


	.referencia {
		display: grid;

		grid-template-columns:
			55px 1fr;

		align-items:
			flex-start;

		gap: 18px;

		padding:
			18px 22px;

		border:
			1px solid #e7e9ee;

		border-radius: 15px;

		background: white;

		transition:
			transform .25s ease,
			border-color .25s ease;
	}


	.referencia:hover {
		transform:
			translateX(7px);

		border-color: #a5b4fc;
	}


	.ref-numero {
		width: 45px;
		height: 45px;

		display: grid;
		place-items: center;

		border-radius: 12px;

		background: #eef2ff;

		color: #4f46e5;

		font-weight: 800;

		font-size: .85rem;
	}


	.referencia p {
		margin: 0;

		color: #555f70;

		line-height: 1.7;
	}


	.referencia strong {
		color: #30394a;
	}



	/* ==========================================
	   FINAL
	========================================== */

	.final {
		padding:
			70px 30px;

		text-align: center;

		background:
			linear-gradient(
				135deg,
				#eef2ff,
				#faf5ff
			);
	}


	.final span {
		display: inline-block;

		padding:
			6px 13px;

		background: white;

		border-radius: 999px;

		color: #4f46e5;

		font-weight: 800;
	}


	.final h2 {
		margin:
			15px 0 8px;

		color: #252d3d;
	}


	.final p {
		margin: 0;

		color: #747c8d;
	}



	/* ==========================================
	   ANIMACIONES
	========================================== */

	.seccion-aparecer {
		opacity: 0;

		transform:
			translateY(30px);

		transition:
			opacity .7s ease,
			transform .7s ease;
	}


	.seccion-aparecer.visible {
		opacity: 1;

		transform:
			translateY(0);
	}


	@keyframes flotar {

		0%,
		100% {
			transform:
				translateY(0);
		}

		50% {
			transform:
				translateY(-8px);
		}

	}


	@keyframes entrada {

		from {
			opacity: 0;

			transform:
				translateY(18px);
		}

